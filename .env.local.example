# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Dashboard > Project Settings > API > service_role secret key
# 非公開の product-files バケットの署名付き URL 発行に使う（RLS を回避する強力な鍵）。
# 絶対にクライアントに渡さない・NEXT_PUBLIC_ を付けない・git にコミットしない。
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle が DB に直接接続するための文字列
# Supabase Dashboard > Project Settings > Database > Connection string
# migration には Direct connection または Session pooler を推奨
# 例: postgresql://postgres.xxxx:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Stripe (https://dashboard.stripe.com/apikeys)
# テストモードの sk_test_... を使うこと
STRIPE_SECRET_KEY=
# Webhook 署名シークレット (https://dashboard.stripe.com/webhooks / stripe listen 時は CLI が発行)
STRIPE_WEBHOOK_SECRET=

# 決済完了後のリダイレクト先を組み立てるためのサイト URL
# 例: http://localhost:3000 (開発) / https://your-app.example.com (本番)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
